version: "3.9"
services:
  frontend-dev:
    image: node:22
    container_name: pd-intranet-frontend-dev
    working_dir: /workspace
    volumes:
      - ./src/frontend-spfx-placeholder:/workspace
    ports:
      - "4321:4321"
      - "3000:3000"
    command: sh -c "echo 'SPFx placeholder container. In a real project run pnpm install && pnpm run dev.' && tail -f /dev/null"

  mock-api:
    image: node:22
    container_name: pd-intranet-mock-api
    working_dir: /workspace
    volumes:
      - ./src/backend-functions-placeholder:/workspace
    ports:
      - "5000:5000"
    command: sh -c "echo 'Mock API placeholder for Graph/Azure/SharePoint data simulation.' && tail -f /dev/null"

  mock-db:
    image: postgres:15
    container_name: pd-intranet-mock-db
    environment:
      POSTGRES_DB: pd_intranet
      POSTGRES_USER: group10
      POSTGRES_PASSWORD: group10pass
    ports:
      - "5432:5432"
    volumes:
      - ./src/database-placeholder:/docker-entrypoint-initdb.d
